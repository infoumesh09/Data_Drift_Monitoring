# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=driftsense
POSTGRES_USER=driftsense
POSTGRES_PASSWORD=driftsense_password

# Database URL (computed from above)
DATABASE_URL=postgresql+psycopg2://driftsense:driftsense_password@localhost:5432/driftsense

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
BACKEND_ENV=development

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Storage Configuration
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/uploads

# AI/LLM Configuration (for later phases)
LLM_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Application
APP_NAME=DriftSense
APP_VERSION=0.1.0
SECRET_KEY=change-this-secret-key-in-production-abc123xyz
